{
  "name": "decamino-web",
  "private": true,
  "version": "2026.08.03.1331",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-quill-vulnerability.cjs",
    "audit:prod": "npm audit --omit=dev",
    "audit:dev": "npm audit",
    "dev": "vite",
    "dev:frontend:decamino": "vite --mode decamino",
    "dev:frontend:hera": "node scripts/generate-hera-pwa-icon.mjs && vite --mode hera --port 5174",
    "dev:hera": "node scripts/generate-hera-pwa-icon.mjs && vite --mode hera --port 5174",
    "dev:client2": "vite --mode client2 --port 5174",
    "build": "node update-version.js && vite build",
    "build:frontend:decamino": "node update-version.js && vite build --mode decamino",
    "build:frontend:decamino:prod": "node update-version.js && cross-env VITE_API_URL=https://api.decaminoservicios.com VITE_API_BASE_URL=https://api.decaminoservicios.com VITE_BACKEND_URL=https://api.decaminoservicios.com vite build --mode decamino",
    "hera:generate-pwa-icon": "node scripts/generate-hera-pwa-icon.mjs",
    "build:frontend:hera": "node scripts/generate-hera-pwa-icon.mjs && node update-version.js && vite build --mode hera",
    "build:frontend:hera:prod": "node scripts/generate-hera-pwa-icon.mjs && node update-version.js && cross-env VITE_API_URL=https://api.herafs.com VITE_API_BASE_URL=https://api.herafs.com VITE_BACKEND_URL=https://api.herafs.com vite build --mode hera",
    "build:frontend:all": "npm run build:frontend:decamino && npm run build:frontend:hera",
    "build:frontend:prod:all": "npm run build:frontend:decamino:prod && npm run build:frontend:hera:prod",
    "build:client2": "node update-version.js && vite build --mode client2",
    "build:no-version": "vite build",
    "version:bump": "node scripts/versioning.js patch",
    "version:bump:minor": "node scripts/versioning.js minor",
    "version:bump:major": "node scripts/versioning.js major",
    "release:notes": "node scripts/changelog-from-commits.js",
    "legal-pdfs:borrador": "node scripts/generate-legal-pdfs.mjs",
    "preflight": "node scripts/preflight.js",
    "lint": "node scripts/lint-incremental.js",
    "lint:resume": "node scripts/lint-incremental.js --resume",
    "lint:skip-large": "node scripts/lint-incremental.js --skip-very-large",
    "lint:clear": "node scripts/lint-incremental.js --clear",
    "lint:file": "cross-env NODE_OPTIONS=--max-old-space-size=16384 npx eslint",
    "lint:cuadrantes": "cross-env NODE_OPTIONS=--max-old-space-size=16384 npx eslint \"src/pages/CuadrantesEmpleadoPage.jsx\" --ext js,jsx --max-warnings 20 --no-cache",
    "lint:direct": "cross-env NODE_OPTIONS=--max-old-space-size=16384 npx eslint src --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0 --cache --cache-location .eslintcache",
    "lint:pages": "cross-env NODE_OPTIONS=--max-old-space-size=8192 npx eslint src/pages --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0 --cache --cache-location .eslintcache",
    "lint:components": "cross-env NODE_OPTIONS=--max-old-space-size=8192 npx eslint src/components --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0 --cache --cache-location .eslintcache",
    "lint:hooks": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx eslint src/hooks --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0 --cache --cache-location .eslintcache",
    "lint:utils": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx eslint src/utils --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0 --cache --cache-location .eslintcache",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx eslint . --ext js,jsx,ts,tsx --fix --cache --cache-location .eslintcache",
    "preview": "vite preview",
    "proxy": "node proxy-server.js",
    "test-jwt": "node scripts/test/test-jwt-auth.js"
  },
