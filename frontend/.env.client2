# Client 2 (HERA) – încărcat automat când rulezi: npm run dev:client2
# Backend HERA local pe 3002 (Decamino pe 3000). Pentru ambele: npm run dev:both în backend.
VITE_API_URL=http://localhost:3002
VITE_API_BASE_URL=http://localhost:3002
# Culoare brand HERA – albastru (fără tentă verde)
VITE_PRIMARY_COLOR=#2563A8
# Logo HERA (header, tab, pagini firmar) – logo-hera.svg (actualizat)
VITE_LOGO_PATH=logo-hera.svg
# Icon PWA la instalare (Android/splash) – PNG recomandat; fallback la VITE_LOGO_PATH
VITE_PWA_ICON=logo-hera.svg
# Nume afișat în tab și în textul „portal de firma de %VITE_APP_NAME%”
VITE_APP_NAME=HERA FACILITY SERVICES SL
# Telefon HERA (PDF-uri, documente, footer)
VITE_COMPANY_PHONE=918 28 03 12
# WhatsApp HERA (raportare erori, contact) – E.164 fără +: 34 + 600522737
VITE_WHATSAPP_PHONE=34600522737
