# Frontend .env.example – șablon pentru DECAMINO și HERA.
# Copiază la .env.decamino.local sau .env.hera.local și completează.
# Nu pune secrete aici. Fișierele .env*.local sunt în .gitignore.
# Build: vite --mode decamino (încarcă .env.decamino.local) sau --mode hera (.env.hera.local).

# === COMMON ===
VITE_APP_NAME=
VITE_APP_VERSION=
VITE_BASE_PATH=
VITE_API_BASE=
VITE_API_URL=
VITE_API_BASE_URL=
VITE_BACKEND_URL=

# === Company (UI, PDF) ===
VITE_COMPANY_NAME=
VITE_COMPANY_NAME_LEGAL=
VITE_COMPANY_EMAIL=
# Email gestoria (destinatatar default la „Enviar a gestoria”). Opțional; dacă lipsește se folosește VITE_COMPANY_EMAIL.
VITE_COMPANY_GESTORIA_EMAIL=
VITE_COMPANY_PHONE=
VITE_COMPANY_CIF=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_CP_POBLACION=
VITE_WHATSAPP_PHONE=

# === Theme ===
VITE_PRIMARY_COLOR=
VITE_SECONDARY_COLOR=

# === Assets ===
VITE_LOGO_PATH=

# === n8n (opțional) ===
VITE_N8N_BASE_URL=

# === External ===
VITE_EXTERNAL_SITE_URL=
# URL de la aplicación interna (email bienvenida)
VITE_APP_URL=https://app.decaminoservicios.com

# === Feature flags (opțional) ===
# Asistente IA: por defecto los empleados autenticados también ven el chat (RBAC en backend).
# Pon false para limitar el widget a Manager/Supervisor/Developer/Admin/Jefe.
# VITE_ASSISTANT_FOR_EMPLOYEES=false
# VITE_SIGNING_MOCK=
# VITE_ENABLE_EINVOICE_XML=
# VITE_UPLOAD_BAJAS_MEDICAS=
# VITE_DEBUG_MODE=
# VITE_PDF_QUALITY=
# VITE_MAX_FILE_SIZE=
# VITE_USE_NEW_PERMISSIONS=
# VITE_USE_NEW_PROTECTION=
# VITE_LOG_PERMISSION_DISCREPANCIES=
# VITE_DEMO=
# VITE_GOOGLE_MAPS_API_KEY=

# === Idle (opțional) ===
# VITE_IDLE_ENABLED=
# VITE_IDLE_TIMEOUT_MIN=
# VITE_IDLE_WARNING_SEC=
