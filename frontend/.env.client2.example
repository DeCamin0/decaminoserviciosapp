# Frontend – CLIENT 2: HERA FACILITY SERVICES SL (același cod, alt .env la build).
# Pentru build Client 2: cp .env.client2.example .env.production (sau .env) apoi npm run build.

# API (backend HERA – https://api.herafs.com)
VITE_API_URL=https://api.herafs.com
VITE_API_BASE_URL=https://api.herafs.com
VITE_BASE_PATH=/

# Logo HERA (header, tab, firmar) – logo-hera.svg
VITE_LOGO_PATH=logo-hera.svg
# Icon PWA la instalare (192/512) – PNG (LOGO_hera.png) sau lasă pentru maskable
VITE_PWA_ICON=LOGO_hera.png

# Company – HERA FACILITY SERVICES SL
VITE_COMPANY_NAME=HERA FACILITY SERVICES SL
VITE_COMPANY_NAME_LEGAL=HERA FACILITY SERVICES SL
VITE_COMPANY_EMAIL=info@herafs.com
# Email gestoria HERA (destinatatar default la „Enviar a gestoria”)
VITE_COMPANY_GESTORIA_EMAIL=emilia@prasser.net
VITE_COMPANY_PHONE=918 28 03 12
# WhatsApp (raportare erori) – E.164 fără + (ex: 34600522737 pentru 600 52 27 37)
VITE_WHATSAPP_PHONE=34600522737
VITE_COMPANY_CIF=B85974558
VITE_COMPANY_ADDRESS=Calle Gran Capitan 5 - Piso 3 D, 28802 Alcalá de Henares, Madrid, España
VITE_COMPANY_CP_POBLACION=28802 - Alcalá de Henares

# Theme – brand HERA: albastru (fără tentă verde)
VITE_PRIMARY_COLOR=#2563A8

# App / PWA (nume în tab, la instalare)
VITE_APP_NAME=HERA FACILITY SERVICES SL
VITE_APP_VERSION=1.0.0

VITE_EXTERNAL_SITE_URL=https://herafs.com
