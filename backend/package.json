{
  "name": "decaminoservicios-backend",
  "version": "0.0.1",
  "description": "Backend API for DeCamino Servicios - Gradually replacing n8n workflows",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npx nest start",
    "start:dev": "node scripts/run-decamino-dev.js --watch",
    "start:debug": "npx nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "dev:backend:decamino": "node scripts/run-decamino-dev.js --watch",
    "dev:backend:hera": "node scripts/launch-nest-client2.js --watch",
    "client2": "node scripts/launch-nest-client2.js --watch",
    "dev:hera": "node scripts/launch-nest-client2.js --watch",
    "start:client2": "node scripts/launch-nest-client2.js",
    "start:dev:client2": "node scripts/launch-nest-client2.js --watch",
    "start:client2-nest": "node scripts/launch-nest-client2.js",
    "dev:both": "concurrently -n decamino,hera -c blue,green \"npm run start:dev\" \"node scripts/delay-then-client2.js\"",
    "check:ports": "node scripts/check-ports.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:create-notifications": "node scripts/create-notifications-table.js",
    "db:create-push-subscriptions": "node scripts/create-push-subscriptions-table.js",
    "db:create-grupos-referencia": "node scripts/create-grupos-referencia-table.js",
    "db:create-fichaje-regularizacion": "node scripts/run-fichaje-regularizacion-migration.js",
    "db:add-no-punch-type": "node scripts/run-no-punch-migration.js",
    "db:add-prl-documentos": "node scripts/run-prl-documentos-migration.js",
    "db:add-presupuestos-guardados": "node scripts/run-presupuestos-guardados-migration.js",
    "pdf:manual-empleados": "node scripts/generate-manual-empleados-pdf.js",
    "pdf:manual-empleados-pandoc": "node scripts/generate-manual-empleados-pdf-pandoc.js",
    "pdf:manual-empleados-pandoc-simple": "node scripts/generate-manual-empleados-pdf-pandoc-simple.js",
    "pdf:manual-empleados-pdfmake": "node scripts/generate-manual-empleados-pdf-pdfmake.js",
    "presupuesto:build-template": "node scripts/build-presupuesto-template.js",
    "presupuesto:create-from-original": "node scripts/create-template-from-original.js",
    "import:developer-to-hera": "node scripts/import-developer-user-to-hera.js",
    "db:setup-tenant-registry": "node scripts/setup-tenant-registry.js .env.decamino.local",
    "db:seed-existing-tenants": "node scripts/seed-existing-tenants-registry.js .env.decamino.local && node scripts/seed-existing-tenants-registry.js .env.hera.local",
    "db:tenant-registry-inactive": "node scripts/run-tenant-registry-enum-inactive.js .env.decamino.local",
    "db:migrate:decamino": "node scripts/prisma-migrate-env.js .env.decamino.local",
    "db:migrate:hera": "node scripts/prisma-migrate-env.js .env.hera.local",
    "db:migrate:both": "node scripts/prisma-migrate-env.js .env.decamino.local && node scripts/prisma-migrate-env.js .env.hera.local",
    "db:migrate:contacto-emergencia": "node scripts/run-contacto-emergencia-migration.js .env.decamino.local && node scripts/run-contacto-emergencia-migration.js .env.hera.local"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/platform-socket.io": "^11.1.11",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.11",
    "@prisma/client": "^5.22.0",
    "@types/archiver": "^7.0.0",
    "@types/imapflow": "^1.0.23",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.4",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "axios": "^1.16.0",
    "bcrypt": "^5.1.1",
    "docx": "^9.5.3",
    "docxtemplater": "^3.68.2",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.2",
    "image-size": "^2.0.2",
    "imapflow": "^1.2.6",
    "multer": "^2.1.0",
    "mammoth": "^1.11.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^8.0.4",
    "openai": "^6.15.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pdfmake": "^0.3.2",
    "pizzip": "^3.2.0",
    "qs": "^6.14.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.11",
    "@types/adm-zip": "^0.5.5",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.12",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "glob": "^11.0.0",
    "globals": "^17.3.0",
    "inquirer": "^10.2.2",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "tmp": "^0.2.6",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "path-to-regexp": "8.4.0",
    "nodemailer": "^8.0.4",
    "picomatch": "4.0.4",
    "multer": "^2.1.0",
    "glob": "^11.0.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "inquirer": "^10.2.2",
    "tar": "^7.5.8",
    "serialize-javascript": "^7.0.3",
    "diff": "^8.0.3",
    "lodash": "^4.17.23",
    "fast-xml-parser": "^5.7.3",
    "@aws-sdk/xml-builder": {
      "fast-xml-parser": "^5.7.3"
    },
    "mammoth": {
      "@xmldom/xmldom": "0.8.10"
    },
    "docxtemplater": {
      "@xmldom/xmldom": "^0.9.10"
    },
    "minimatch": "^10.2.1",
    "ajv": "^8.18.0",
    "eslint": {
      "ajv": "6.14.0"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
