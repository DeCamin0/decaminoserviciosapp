model FichajeRegularizacion {
  id Int @id @default(autoincrement())

  // Workday identification (NOT calendar date)
  employee_codigo String   @db.VarChar(50)
  workday_date    DateTime @db.Date // Shift start date (22:00-06:00 → date of 22:00)

  // Time window for this workday (covers all shifts, including night shifts)
  window_start DateTime @db.DateTime(0) // First Entrada of workday
  window_end   DateTime @db.DateTime(0) // Last Salida of workday (may be next day)

  // Regularization data
  fichaje_ids         String?                     @db.Text // JSON array of fichaje IDs in this workday
  regularization_type FichajeRegularizacionType
  status              FichajeRegularizacionStatus

  scheduled_minutes Int // From cuadrante/horario for workday_date (sum multiple segments if split)
  punched_minutes   Int // Sum of all durations in [window_start, window_end]
  effective_minutes Int? // Final minutes used in reports

  reason_code String? @db.VarChar(100)
  notes       String? @db.Text

  created_by   String    @db.VarChar(50) // employee/admin/system
  created_at   DateTime  @default(now()) @db.Timestamp(0)
  confirmed_at DateTime? @db.Timestamp(0)
  reviewed_at  DateTime? @db.Timestamp(0)
