  clienteTipos   ServicioPeriodicoClienteTipo[]

  @@index([activo, orden], map: "idx_sp_tipos_activo_orden")
  @@map("servicios_periodicos_tipos")
}

/// Tipos de servicio periódicos asignados a un cliente/comunidad.
model ServicioPeriodicoClienteTipo {
  id         Int                   @id @default(autoincrement())
  cliente_id Int                   @map("cliente_id")
  tipo_id    Int                   @map("tipo_id")
  creado_en  DateTime              @default(now()) @map("creado_en") @db.Timestamp(0)
  cliente    Clientes              @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_sp_cli_tipo_cliente")
  tipo       ServicioPeriodicoTipo @relation(fields: [tipo_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_sp_cli_tipo_tipo")

  @@unique([cliente_id, tipo_id], map: "uq_sp_cli_tipo")
  @@index([cliente_id], map: "idx_sp_cli_tipo_cliente")
  @@index([tipo_id], map: "idx_sp_cli_tipo_tipo")
  @@map("servicios_periodicos_cliente_tipos")
}

model ServicioPeriodicoCheck {
  id                 Int                   @id @default(autoincrement())
  cliente_id         Int                   @map("cliente_id")
  tipo_id            Int                   @map("tipo_id")
  an                 Int
  mes                Int
  hecho              Boolean               @default(false)
  fecha_realizacion  DateTime?             @map("fecha_realizacion") @db.Date
  hecho_por          String?               @map("hecho_por") @db.VarChar(100)
  nota               String?               @db.VarChar(500)
  creado_en          DateTime              @default(now()) @map("creado_en") @db.Timestamp(0)
  actualizado_en     DateTime              @default(now()) @updatedAt @map("actualizado_en") @db.Timestamp(0)
  tipo               ServicioPeriodicoTipo @relation(fields: [tipo_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_sp_check_tipo")

  @@unique([cliente_id, tipo_id, an, mes], map: "uq_sp_check_cliente_tipo_an_mes")
  @@index([an, mes], map: "idx_sp_check_an_mes")
  @@index([cliente_id, an], map: "idx_sp_check_cliente_an")
  @@map("servicios_periodicos_checks")
}

