# --- Server ---
PORT=3000
NODE_ENV=production

# --- CORS / API ---
CORS_ORIGINS=https://app.decaminoservicios.com,https://decaminoservicios.com
API_URL=https://api.decaminoservicios.com

# --- Database (OBLIGATORIU) ---
DB_TYPE=mysql
DB_HOST=217.154.102.115
DB_PORT=3306
DB_USERNAME=facturacion_user
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_NAME=decamino_db
DB_SYNC=false
DB_LOGGING=false
DATABASE_URL=mysql://facturacion_user:REPLACE_WITH_DB_PASSWORD@217.154.102.115:3306/decamino_db

# --- JWT ---
JWT_SECRET=REPLACE_WITH_LONG_SECRET_KEY
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# --- Company (OBLIGATORIU – validare la pornire) ---
COMPANY_LEGAL_NAME=DE CAMINO SERVICIOS AUXILIARES, S.L.
