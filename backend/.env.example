# Backend .env.example – șablon pentru DECAMINO și HERA.
# Copiază la .env.decamino.local sau .env.hera.local și completează valorile.
# Nu pune secrete aici. Fișierele .env*.local sunt în .gitignore.

# === COMMON (Server) ===
PORT=
NODE_ENV=

# === CORS / API ===
# Origin-uri permise (virgulă); sau CORS_ORIGIN pentru un singur origin.
CORS_ORIGINS=
CORS_ORIGIN=
# URL public al API-ului (loguri, link-uri).
API_URL=

# === Database (OBLIGATORIU) ===
DB_TYPE=
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SYNC=
DB_LOGGING=
# Opțional; dacă lipsește se construiește din DB_*.
# DATABASE_URL=

# === Leads scraper (opcional) ===
# Intérprete Python para POST /api/leads/scrape (por defecto: python)
# LEADS_PYTHON=py -3
# Pausas anti-429 (las hereda el subprocess Python; ver tools/spanish-leads-scraper/README.md)
# Si no defines nada, Nest inyecta valores conservadores (LEADS_EMPRESITE_*).
# LEADS_INTER_SOURCE_DELAY_SEC=8-15
# LEADS_EMPRESITE_DELAY_SEC=10-22
# LEADS_EMPRESITE_INITIAL_DELAY_SEC=15
# LEADS_EMPRESITE_429_RETRIES=6
# LEADS_EMPRESITE_MAX_URLS=4
# LEADS_EMPRESITE_MAX_PHRASES=2

# === JWT ===
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
# Portal clientes (OTP): firma distinta a empleados; en producción definir JWT_PORTAL_SECRET explícito.
# JWT_PORTAL_SECRET=
# JWT_PORTAL_EXPIRES_IN=12h
# Tras OTP portal gestores (varias comunidades): token para elegir cliente (ej. 15m).
# JWT_PORTAL_SELECT_EXPIRES_IN=15m
# PORTAL_OTP_TTL_MINUTES=10
# PORTAL_OTP_PEPPER= (opcional; refuerza hash del código 6 dígitos)

# === Company (OBLIGATORIU – PDF, email, legal) ===
COMPANY_LEGAL_NAME=
COMPANY_LEGAL_NAME_SHORT=
COMPANY_ADDRESS=
COMPANY_ADDRESS_LINE1=
COMPANY_CP_POBLACION=
COMPANY_CIF=
COMPANY_PHONE=
COMPANY_EMAIL=
# BCC la mailuri (gestoria, angajați) – mai multe adrese separate prin virgulă
COMPANY_EMAIL_BCC=
COMPANY_SOLICITUDES_EMAIL=
# Email destinatar principal gestoria (fiche, despido, baja, etc.). Dacă lipsește se folosește COMPANY_EMAIL.
# COMPANY_GESTORIA_EMAIL=mirisjm@gmail.com
# CC la emailuri către gestoria – adrese separate prin virgulă (opțional).
# COMPANY_GESTORIA_CC=altemprado@gmail.com
COMPANY_EMAIL_FROM_NAME=
COMPANY_WEBSITE=
COMPANY_BRAND_RED=
COMPANY_LOGO_PATH=
# Stamp/sello pentru pagina Aceptación (PDF). Nume fișier în assets/ (ex. sello hera firma 10-07-25.png). Opțional.
# COMPANY_STAMP_PATH=
# Presupuesto página Presentación: decamino (texto Decamino) o hera (texto HERA). Por defecto decamino.
# COMPANY_PRESUPUESTO_PRESENTACION_KEY=decamino
# Opțional: portada PDF (fundal, culoare text).
# COMPANY_PORTADA_BG=
# COMPANY_PORTADA_TEXT_COLOR=
FRONTEND_APP_URL=

# === n8n ===
N8N_BASE_URL=
N8N_TIMEOUT=
N8N_RATE_LIMIT_MAX_BURST=
N8N_RATE_LIMIT_RPS=
N8N_RATE_LIMIT_MAX_QUEUE=
N8N_BACKOFF_BASE_MS=
N8N_BACKOFF_MAX_RETRIES=
N8N_BACKOFF_JITTER_MS=

# === SMTP (email gestoria, angajați) ===
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# === SMTP Pedidos (opțional; fallback la SMTP principal) ===
SMTP_PEDIDOS_HOST=
SMTP_PEDIDOS_PORT=
SMTP_PEDIDOS_SECURE=
SMTP_PEDIDOS_USER=
SMTP_PEDIDOS_PASSWORD=
SMTP_PEDIDOS_FROM=

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN_GENERAL=
TELEGRAM_CHAT_ID_GENERAL=
TELEGRAM_CLIENT_LABEL=

# === VAPID (Push Notifications) ===
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# === Frontend / WebSocket ===
FRONTEND_URL=

# === Firmar (opțional; fallback la FRONTEND_APP_URL) ===
# FIRMAR_BASE_URL=

# === Logging / Monitoring ===
LOG_LEVEL=
MONITORING_ENABLED=

# === IMAP (opțional – email ingestion) ===
# IMAP_HOST=
# IMAP_PORT=
# IMAP_SECURE=
# IMAP_MAILBOX=
IMAP_PROCESSED_MAILBOX=

# === Assistant (OpenAI) ===
# Fără cheie: intenturile „generale” (salut, small-talk) folosesc doar fallback static; cu cheie: răspunsuri naturale când nu e nevoie doar de date.
# Obține cheie: https://platform.openai.com/api-keys
# Local: pune în .env.decamino.local / .env.hera.local (gitignored).
# Producție VPS: aceeași variabilă în fișierul încărcat de systemd (ex. EnvironmentFile=/opt/.../.env), apoi:
#   systemctl restart decamino-backend
# === Reverse geocoding (GPS → adresă) ===
# Lanț pe server: Nominatim → Photon (implicit https://photon.komoot.io) → Google (opțional).
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org  # opțional, alt mirror
# PHOTON_GEOCODING_URL=https://photon.komoot.io           # opțional, instanță proprie
# GOOGLE_GEOCODING_API_KEY=                                # opțional; restricție IP pe cheie

# Verificare la pornire în loguri: "OpenAI service initialized" (nu "OPENAI_API_KEY not found").
OPENAI_API_KEY=
# true / 1 → log [assistant:pipeline] (intent, entidades enmascaradas, tool ejecutado, vacío/error SQL, response_language: detectedLanguage + source preferences|auto-detect). Sin texto del usuario.
# ASSISTANT_PIPELINE_DEBUG=false

# === Super-admin: tenant registry + provisioning (OPȚIONAL) ===
# Bază separată pentru tabela tenants + loguri. Rulează migrations/tenant_registry_tables.sql pe acea bază.
# TENANT_REGISTRY_DATABASE_URL=mysql://user:pass@host:3306/tenant_registry
# Cheie 32 octeți hex (generează: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# TENANT_DB_PASSWORD_ENCRYPTION_KEY=
# Cont MySQL cu drepturi CREATE DATABASE / CREATE USER (NU în UI — doar server)
# DB_PROVISION_HOST=
# DB_PROVISION_PORT=3306
# DB_PROVISION_USER=
# DB_PROVISION_PASSWORD=
# Host pentru userii app_<slug> (default %)
# DB_PROVISION_APP_USER_HOST=%
# Opțional: emailuri extra super-admin (virgulă), pe lângă GRUPO=Developer
# SUPER_ADMIN_EMAILS=

# === Build / runtime (setat de scripturi, nu în .env) ===
# ENV_FILE=.env.decamino.local sau .env.hera.local
