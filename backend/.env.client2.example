# Backend – CLIENT 2: HERA FACILITY SERVICES SL (același cod, alt .env).
# Copiază: cp .env.client2.example .env (pe serverul/containerul Client 2) și completează email, tel, domenii.

# ========== Database (Client 2 – baza dedicată HERA) ==========
DB_TYPE=mysql
DB_HOST=217.154.102.115
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=ParolaTare123!
DB_NAME=hera_facility_db
# Prisma folosește DATABASE_URL; dacă lipsește, e construită din DB_* de PrismaService.
# Pentru `npx prisma migrate deploy` poți seta explicit (înlocuiește PAROLA):
# DATABASE_URL="mysql://root:PAROLA@localhost:3306/hera_facility_db?charset=utf8mb4"

# ========== JWT (folosește secret DIFERIT de Client 1) ==========
JWT_SECRET=hera-client2-secret-key-change-in-production
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# ========== Company – HERA FACILITY SERVICES SL ==========
COMPANY_LEGAL_NAME=HERA FACILITY SERVICES SL
COMPANY_LEGAL_NAME_SHORT=HERA FACILITY SERVICES SL
# Detección nombre en hojas de salario: texto que separa nombre empleado de empresa en PDF (línea tras "Periodo de liquidación")
COMPANY_NOMINA_NAME_SEPARATOR=HERA FACILITY
COMPANY_ADDRESS=Calle Gran Capitan 5 - Piso 3 D\n28802 Alcalá de Henares, Madrid, España
COMPANY_ADDRESS_LINE1=Calle Gran Capitan 5 - Piso 3 D
COMPANY_CP_POBLACION=28802 - Alcalá de Henares
COMPANY_CIF=B85974558
COMPANY_PHONE=918 28 03 12
COMPANY_EMAIL=administracion@herafs.com
COMPANY_EMAIL_BCC=app@herafs.com
COMPANY_SOLICITUDES_EMAIL=administracion@herafs.com
# Gestoria HERA: destinatar principal și CC. Dacă lipsește COMPANY_GESTORIA_EMAIL se folosește COMPANY_EMAIL.
COMPANY_GESTORIA_EMAIL=emilia@prasser.net
COMPANY_GESTORIA_CC=paula@prasser.net
COMPANY_EMAIL_FROM_NAME=HERA FACILITY SERVICES SL
COMPANY_WEBSITE=https://herafs.com
# Brand HERA: același albastru ca aplicația (sincronizează cu VITE_PRIMARY_COLOR din frontend)
COMPANY_BRAND_RED=#2563A8
# Portada PDF (presupuestos/informes): fundal albastru deschis ca la login, text închis pentru contrast și logo vizibil
COMPANY_PORTADA_BG=#9EC9E6
COMPANY_PORTADA_TEXT_COLOR=#1e3a5f
COMPANY_LOGO_PATH=LOGO_hera.png
# Si el mismo backend sirve Decamino y HERA, usa estos para presupuestos HERA (logo y sello).
# COMPANY_LOGO_PATH_HERA=LOGO_hera.png
# COMPANY_STAMP_PATH_HERA=stampila_hera-removebg-preview.png
# Sello HERA para página Aceptación (presupuesto/informe PDF). Archivo en backend/assets/
COMPANY_STAMP_PATH=stampila_hera-removebg-preview.png
# Presupuesto: texto de la página 1.1 Presentación para HERA (no el de Decamino)
COMPANY_PRESUPUESTO_PRESENTACION_KEY=hera
# URL unde se servește aplicația (linkuri firmar, redirecturi)
FRONTEND_APP_URL=https://app.herafs.com

# ========== n8n (opțional) ==========
# N8N_BASE_URL=https://n8n.herafs.com

# ========== CORS / API – domeniile Client 2 ==========
CORS_ORIGINS=https://app.herafs.com,https://herafs.com
API_URL=https://api.herafs.com

# ========== Telegram – gestoria + general (HERA = bot/chat DIFERIT de Decamino) ==========
# IMPORTANT: La HERA folosește un BOT și un CHAT ID DIFERITE de Decamino, ca notificările
# gestoria (nóminas, documentos, ausencias, pedidos, etc.) să ajungă în chat-ul HERA, nu în Decamino.
# Gestoria: bot + chat doar pentru HERA (creat cu @BotFather, grup Telegram dedicat HERA).
TELEGRAM_BOT_TOKEN=your-hera-gestoria-bot-token-from-botfather
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
# General (erori, alerte): poți folosi același bot/chat HERA sau unul separat.
TELEGRAM_BOT_TOKEN_GENERAL=your-hera-general-bot-token
TELEGRAM_CHAT_ID_GENERAL=-100xxxxxxxxxx
TELEGRAM_CLIENT_LABEL=HERA

# ========== SMTP HERA – administracion@herafs.com (provider: interdominios) ==========
# Config client mail: https://lh004.interdominios.com:8443/configure-mail-client.php?emailaddress=administracion@herafs.com
# Completează SMTP_PASSWORD (și dacă e cazul SMTP_HOST/SMTP_PORT) din datele de la provider.
SMTP_HOST=lh004.interdominios.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=administracion@herafs.com
SMTP_PASSWORD=herafs2019.
SMTP_FROM=HERA FACILITY SERVICES SL <administracion@herafs.com>

# ========== SMTP DOAR pentru Pedidos (același cont ca Client 1; diferența e doar FROM = HERA) ==========
SMTP_PEDIDOS_HOST=smtp.serviciodecorreo.es
SMTP_PEDIDOS_PORT=465
SMTP_PEDIDOS_SECURE=true
SMTP_PEDIDOS_USER=produccion@decaminoservicios.com
SMTP_PEDIDOS_PASSWORD=your-pedidos-password
SMTP_PEDIDOS_FROM=HERA FACILITY SERVICES SL <produccion@decaminoservicios.com>

# ========== Restul (PORT, VAPID, etc.) ==========
# Pe același VPS cu Client 1: folosește alt port (ex. 3002) ca backend Decamino să rămână pe 3000.
# Pe server dedicat HERA: poți lăsa PORT=3000.
PORT=3002

# ========== VAPID (Push Notifications – opțional, ca la Client 1) ==========
# Fără VAPID: backend generează chei la fiecare restart → subscription-urile se invalidează. Pentru producție, completează.
# Poți folosi aceleași chei ca Client 1 sau pereche separată pentru HERA.
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
